{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.newmind.chat",
  "productName": "NewChat",
  "copyright": "Copyright © 2025 Newmind Technologies",
  "asar": true,
  "npmRebuild": false,
  "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
  "protocols": {
    "name": "dive",
    "schemes": [
      "dive"
    ]
  },
  "electronLanguages": ["en", "zh-CN"],
  "publish": [
    {
      "provider": "github",
      "owner": "TocharianOU",
      "repo": "newmind-ai"
    }
  ],
  "asarUnpack": [
    "**/*.node"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "prebuilt/**/*"
  ],
  "mac": {
    "identity": null,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "darkModeSupport": true,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Microphone access may be used by NewmindChat plugins, such as Jitsi video conferencing.",
      "NSCameraUsageDescription": "Camera access may be used by NewmindChat plugins, such as Jitsi video conferencing.",
      "NSFocusStatusUsageDescription": "Focus status is used by NewmindChat to determine whether to send notifications or not.",
      "NSAppleEventsUsageDescription": "need this permission to execute some functions",
      "com.apple.security.cs.allow-jit": true,
      "com.apple.security.cs.allow-unsigned-executable-memory": true,
      "com.apple.security.cs.allow-dyld-environment-variables": true,
      "com.apple.security.temporary-exception.files.absolute-path.read-write": true,
      "com.apple.security.temporary-exception.files.home-relative-path.read-write": true
    },
    "extraResources": [
      {
        "from": "bin/node/darwin-${arch}/",
        "to": "node/",
        "filter": ["**/*"]
      },
      {
        "from": "bin/uv/darwin-${arch}/",
        "to": "uv/",
        "filter": [
          "uv",
          "uvx"
        ]
      },
      {
        "from": "bin/python/darwin-${arch}/",
        "to": "python/",
        "filter": ["**/*"]
      }
    ]
  },
  "win": {
    "icon": "public/icon.png",
    "signAndEditExecutable": false,
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "bin/node/win-x64/",
        "to": "node/",
        "filter": [
          "node.exe",
          "npx.cmd",
          "npm.cmd",
          "node_modules/**/*"
        ]
      },
      {
        "from": "bin/uv/win-x64/",
        "to": "uv/",
        "filter": [
          "uv.exe",
          "uvx.exe"
        ]
      },
      {
        "from": "bin/python/win-x64/",
        "to": "python/",
        "filter": ["**/*"]
      },
      {
        "from": "mcp-host",
        "to": "mcp-host",
        "filter": [
          "**/*",
          "!.venv/**/*",
          "!logs/**/*",
          "!tests/**/*",
          "!.github/**/*",
          "!.vscode/**/*",
          "!*.env",
          "!command_alias.json",
          "!dive_httpd.json",
          "!mcp_config.json",
          "!model_config.json"
        ]
      }
    ]
  },
  "linux": {
    "target": ["AppImage"],
    "asarUnpack": ["**/*.node"],
    "executableName": "newmind-chat",
    "desktop": {
      "entry": {
        "MimeType": "x-scheme-handler/dive;"
      }
    },
    "extraResources": [
      {
        "from": "bin/uv/linux-x64/",
        "to": "uv/",
        "filter": [
          "uv",
          "uvx"
        ]
      },
      {
        "from": "bin/python/linux-x64",
        "to": "python",
        "filter": [
          "**/*",
          "!lib/libpython3.12.so"
        ]
      },
      {
        "from": "mcp-host",
        "to": "mcp-host",
        "filter": [
          "**/*",
          "!.venv/**/*",
          "!logs/**/*",
          "!tests/**/*",
          "!.github/**/*",
          "!.vscode/**/*",
          "!*.env",
          "!command_alias.json",
          "!dive_httpd.json",
          "!mcp_config.json",
          "!model_config.json"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": true
  },
  "extraResources": [
    {
      "from": "prebuilt",
      "to": "prebuilt",
      "filter": ["**/*"]
    },
    {
      "from": "public/image",
      "to": "image",
      "filter": ["**/*"]
    }
  ],
  "dmg": {
    "title": "NewChat ${version}",
    "background": null,
    "window": {
      "width": 540,
      "height": 380
    },
    "contents": [
      {
        "x": 144,
        "y": 150,
        "type": "file"
      },
      {
        "x": 396,
        "y": 150,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
