# MySQL Connection Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=your_password
MYSQL_DB=your_database

# Alternative: Unix Socket Connection (comment out MYSQL_HOST/PORT if using socket)
#MYSQL_SOCKET_PATH=/tmp/mysql.sock

# SSL Configuration
MYSQL_SSL=false

# MCP Transport Mode (stdio or http)
MCP_TRANSPORT=stdio

# HTTP Mode Settings (when MCP_TRANSPORT=http)
MCP_HTTP_PORT=3000
MCP_HTTP_HOST=localhost

# Operation Permissions (set to true to enable write operations)
ALLOW_INSERT_OPERATION=false
ALLOW_UPDATE_OPERATION=false
ALLOW_DELETE_OPERATION=false
ALLOW_DDL_OPERATION=false

# Multi-DB Mode Configuration
# Omit MYSQL_DB to enable multi-database mode
#MULTI_DB_WRITE_MODE=false

# Schema-Specific Permissions (comma-separated schema names)
# Only applies when global permissions are enabled
#SCHEMA_INSERT_PERMISSIONS=schema1,schema2
#SCHEMA_UPDATE_PERMISSIONS=schema1
#SCHEMA_DELETE_PERMISSIONS=schema1
#SCHEMA_DDL_PERMISSIONS=dev_db

# Advanced MySQL Settings
#MYSQL_POOL_SIZE=10
#MYSQL_QUERY_TIMEOUT=30000
#MYSQL_CACHE_TTL=60000
#MYSQL_RATE_LIMIT=100
#MYSQL_ENABLE_LOGGING=true

# Remote MCP Mode (legacy, for backward compatibility)
#IS_REMOTE_MCP=true
#REMOTE_SECRET_KEY=your_secret_key
#PORT=3000
