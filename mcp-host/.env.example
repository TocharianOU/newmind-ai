# ─────────────────────────────────────────────────────────────
# AttackTrace MCP Host — Environment Variables Reference
#
# Copy this file to .env and fill in the values.
# Never commit a .env file containing real secrets.
# ─────────────────────────────────────────────────────────────

# ── Auth ──────────────────────────────────────────────────────
# Internal token used by the Hub (or Electron desktop) to
# authenticate requests to this MCP Host.
# Must match the token configured in AttackTraceHub's .env or
# the desktop app's settings.
ATTACKTRACE_AUTH_TOKEN=change_me_to_a_secure_random_token

# ── Server ────────────────────────────────────────────────────
# Host and port the MCP Host listens on (default: 0.0.0.0:61990)
# ATTACKTRACE_HOST=0.0.0.0
# ATTACKTRACE_PORT=61990
