{
    "mcpServers": {
        "biggo-mcp-server": {
            "transport": "command",
            "command": "uvx",
            "args": [
                "BigGo-MCP-Server@latest"
            ]
        },
        "kibana": {
            "transport": "stdio",
            "command": "node",
            "args": [
                "prebuilt/scripts/mcp-server-kibana/dist/index.js"
            ],
            "env": {
                "KIBANA_URL": "",
                "KIBANA_USERNAME": "",
                "KIBANA_PASSWORD": ""
            },
            "enabled": false
        }
    }
}
