# Dive App Environment Configuration
# Copy this file to .env and update the values

# NewmindHub Backend API (用于API调用和WebSocket)
VITE_API_BASE_URL=http://localhost:23000

# NewmindHub Frontend URL (用于注册/登录页面跳转)
VITE_HUB_BASE_URL=http://localhost:23001

# Proxy Configuration (Optional)
# Uncomment and configure if you need to use a proxy for OpenAI API calls
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
