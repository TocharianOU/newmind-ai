# AttackTrace App Environment Configuration

# ========================================
# Core Configuration (Required)
# ========================================

# Hub Backend API URL
# Used by: Frontend, Python MCP Host, WebSocket connections
VITE_API_BASE_URL=http://localhost:23000

# Hub Frontend URL
# Used by: Login/register page redirects
VITE_HUB_BASE_URL=http://localhost:23001

# ========================================
# Optional Configuration
# ========================================

# Uncomment if you need custom LLM service
# CUSTOM_LMSTUDIO_URL=http://localhost:11234

# ========================================
# Branding (for different customer deployments)
# ========================================

# App display name shown in UI (window title, login page, about page, etc.)
# VITE_APP_NAME=AttackTrace

# Platform / team collaboration service name shown in UI
# VITE_PLATFORM_NAME=OAP Platform

# Installer / OS-level app name (DMG title, Windows installer name, Dock/Taskbar name)
# PRODUCT_NAME=AttackTrace
