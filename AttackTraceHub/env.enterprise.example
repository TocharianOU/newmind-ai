# ─────────────────────────────────────────────────────────────
# AttackTraceHub — Enterprise Deployment Environment Template
#
# Copy to .env and fill in the values.
# This template disables all SaaS/billing features and enables
# the License-based enterprise access control system.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/attacktrace_hub

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS / Origins ────────────────────────────────────────────
# Set to the URL of your internal Hub frontend deployment
ALLOWED_ORIGINS=https://hub.internal.example.com
HUB_FRONTEND_URL=https://hub.internal.example.com

# ── RBAC / Admin ─────────────────────────────────────────────
# First user(s) to receive ADMIN role — set before first run
ADMIN_EMAILS=admin@example.com

# ── Registration ─────────────────────────────────────────────
# Invite codes are enabled by default in enterprise mode.
# Remove or set false to allow open registration (not recommended).
# INVITE_CODE_ENABLED=true

# ── Deployment Mode ───────────────────────────────────────────
DEPLOYMENT_MODE=enterprise

# These flags are derived automatically from DEPLOYMENT_MODE=enterprise,
# but are listed here for visibility. Override only if needed.
BILLING_ENABLED=false
ENTERPRISE_FEATURES_ENABLED=true
LICENSE_ENABLED=true

# ── License Verification ──────────────────────────────────────
# Public key (PEM format, newlines replaced with \n) used to verify
# license file signatures issued by AttackTrace.
# Generate your key pair: node src/license/keygen.js generate-keys
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ── Email (optional) ─────────────────────────────────────────
# Used for password-reset emails. Leave blank to disable email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# ── SSO (optional) ────────────────────────────────────────────
# Enable OIDC/OAuth2 SSO. Leave blank to use username/password only.
# SSO_ENABLED=true
# OIDC_PROVIDER_NAME=Your Identity Provider
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration

# ── AI Providers ─────────────────────────────────────────────
# At least one API key is required for AI features.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# NOTE: Stripe variables are NOT required in enterprise mode.
# Do not set STRIPE_SECRET_KEY or STRIPE_WEBHOOK_SECRET.
