# NewMind AI — Docker environment variables
# Copy to .env and fill in the required values.
# Variables marked [required] MUST be set. Others have sensible defaults.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL superuser password [required]
POSTGRES_PASSWORD=change_me

# JWT signing secret — use: openssl rand -hex 32 [required]
JWT_SECRET=change_me

# Shared auth token between Hub and MCP Host [required]
# Must be identical on both sides — use: openssl rand -hex 32
ATTACKTRACE_AUTH_TOKEN=change_me

# ── Optional (defaults work out of the box) ──────────────────────────────────

# Hub listen port inside the container (mapped via docker-compose ports)
# PORT=3000

# Set to 'true' only if you terminate HTTPS at Nginx/LB in front of Hub.
# When false (default), HSTS and Cross-Origin-Opener-Policy headers are
# disabled so browsers don't force-upgrade HTTP requests to HTTPS.
# FORCE_HTTPS=false

# Comma-separated list of allowed CORS origins.
# Default allows common local dev ports; set this in production.
# ALLOWED_ORIGINS=https://yourdomain.com

# Public URL of the Hub frontend (used for CORS and CSP).
# Only needed if the user-facing URL differs from the Hub's own origin.
# HUB_FRONTEND_URL=https://yourdomain.com
