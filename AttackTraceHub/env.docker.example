# NewMind AI — Docker environment variables
# Copy to .env and fill in the three required values.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL superuser password
POSTGRES_PASSWORD=change_me

# JWT signing secret (use a long random string, e.g. openssl rand -hex 32)
JWT_SECRET=change_me

# Shared auth token between Hub and MCP Host (must match on both sides)
ATTACKTRACE_AUTH_TOKEN=change_me
