# NewMind AI — Docker deployment environment
# Copy this file to .env and fill in values marked [required].
#
# Quick start:
#   cp env.docker.example .env
#   # Edit the 3 required values, then:
#   docker compose --env-file .env build
#   docker compose --env-file .env up -d

# ═══════════════════════════════════════════════════════════════════════════════
# Required — MUST be set
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL superuser password
POSTGRES_PASSWORD=

# JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=

# Shared auth token between Hub ↔ MCP Host (generate: openssl rand -hex 32)
ATTACKTRACE_AUTH_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
# Admin account — auto-created on first startup
# ═══════════════════════════════════════════════════════════════════════════════

# Admin email and password — set both to auto-create on first boot
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# Emails that get ADMIN role when they register (comma-separated)
ADMIN_EMAILS=admin@yourcompany.com

# ═══════════════════════════════════════════════════════════════════════════════
# Networking / Security
# ═══════════════════════════════════════════════════════════════════════════════

# External port (default: 23000)
# PORT=23000

# CORS allowed origins — set to your public URL in production
# Without this, only localhost origins are allowed.
# Example: http://204.168.178.42:23000
ALLOWED_ORIGINS=

# Public URL of the Hub (for CORS/CSP, only if different from ALLOWED_ORIGINS)
# HUB_FRONTEND_URL=

# Set to 'true' ONLY if HTTPS is terminated by a reverse proxy in front of Hub
# FORCE_HTTPS=false

# ═══════════════════════════════════════════════════════════════════════════════
# Feature flags
# ═══════════════════════════════════════════════════════════════════════════════

# Deployment mode: 'enterprise' (default) or 'saas'
DEPLOYMENT_MODE=enterprise

# SSO (OAuth2/OIDC) login — set to 'true' to enable
SSO_ENABLED=false

# Stripe billing — only for SaaS mode
BILLING_ENABLED=false

# Require invite code to register
INVITE_CODE_ENABLED=false

# License-based access control (disable unless you have a license server)
LICENSE_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════════════
# SSO providers (only when SSO_ENABLED=true)
# ═══════════════════════════════════════════════════════════════════════════════

# Base URL for OAuth callbacks (e.g. https://yourdomain.com)
# SSO_CALLBACK_BASE_URL=

# Google OAuth
# SSO_GOOGLE_CLIENT_ID=
# SSO_GOOGLE_CLIENT_SECRET=

# Azure AD / Microsoft
# SSO_AZURE_ENABLED=false
# SSO_AZURE_TENANT_ID=
# SSO_AZURE_CLIENT_ID=
# SSO_AZURE_CLIENT_SECRET=
