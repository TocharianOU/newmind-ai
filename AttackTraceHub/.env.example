# ─────────────────────────────────────────────────────────────
# AttackTraceHub — Environment Variables Reference
#
# Copy this file to .env and fill in the values.
# Never commit a .env file containing real secrets.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────

# Port the Hub listens on (default: 3000)
PORT=3000

# Node environment: development | production
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/attacktrace_hub

# ── JWT Authentication ────────────────────────────────────────

# Secret used to sign and verify JWT tokens (required, min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# Access token lifetime (default: 7d)
JWT_EXPIRES_IN=7d

# Refresh token lifetime (default: 30d)
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS / Origins ────────────────────────────────────────────

# Comma-separated list of additional allowed origins for CORS
# e.g. https://app.example.com,https://dashboard.example.com
ALLOWED_ORIGINS=

# Public URL of the Hub frontend (used for Stripe redirects, SSO callbacks, etc.)
HUB_FRONTEND_URL=http://localhost:23001

# ── RBAC / Admin ─────────────────────────────────────────────

# Comma-separated list of email addresses that are automatically
# granted the ADMIN role when they first register.
# Example: admin@example.com,ops@example.com
ADMIN_EMAILS=

# ── Registration ─────────────────────────────────────────────

# Set to "true" to require an invite code when registering
INVITE_CODE_ENABLED=false

# Comma-separated list of valid invite codes (used when INVITE_CODE_ENABLED=true)
INVITE_CODES=

# ── Deployment Mode ───────────────────────────────────────────
#
# Controls the overall operating mode of the Hub.
#
#   saas       (default) — consumer-facing SaaS with Stripe billing.
#   enterprise — on-premise / customer-cloud deployment with License-based
#                access control. Stripe routes are disabled automatically.
#
# Individual feature flags below are derived from this value but can be
# overridden independently.
DEPLOYMENT_MODE=saas

# ── Feature Flags ─────────────────────────────────────────────

# Enable Stripe billing / payment flows.
# Defaults to "true" in saas mode, "false" in enterprise mode.
# BILLING_ENABLED=true

# Set to "false" to disable audit log exports (JSON/CSV download).
AUDIT_EXPORT_ENABLED=true

# Enable SSO (OAuth2 / OIDC) login providers (default: true).
SSO_ENABLED=true

# Gate enterprise-only features: RBAC admin panel, org management, etc.
# Defaults to "false" in saas mode, "true" in enterprise mode.
# ENTERPRISE_FEATURES_ENABLED=false

# Enable license-based access control (enterprise only).
# Defaults to "false" in saas mode, "true" in enterprise mode.
# LICENSE_ENABLED=false

# Require invite code at registration (defaults to true in enterprise mode).
# INVITE_CODE_ENABLED=false

# ── Stripe / Payments ────────────────────────────────────────
# Leave blank to disable payment features entirely.

# Stripe secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ── Download URLs (optional) ──────────────────────────────────

DOWNLOAD_URL_WINDOWS_X64=
DOWNLOAD_URL_MACOS_INTEL=
DOWNLOAD_URL_MACOS_APPLE_SILICON=
DOWNLOAD_URL_LINUX_X64=
DOWNLOAD_URL_LINUX_ARM64=

# ── System Prompt Override ────────────────────────────────────

# Optional: override the default system prompt for all sessions
# Can also be set at runtime via the API.
DIVE_OVERRIDE_SYSTEM_PROMPT=

# ── Email / SMTP (optional) ───────────────────────────────────
# When SMTP_HOST is not set, reset links are printed to server logs instead.

# SMTP server hostname (e.g. smtp.sendgrid.net, smtp.gmail.com)
SMTP_HOST=
# SMTP port: 587 (STARTTLS, default) or 465 (SSL)
SMTP_PORT=587
# Set to "true" only for port 465
SMTP_SECURE=false
# SMTP credentials
SMTP_USER=
SMTP_PASS=
# Sender address shown to recipients
EMAIL_FROM=noreply@example.com

# ── Proxy (optional) ─────────────────────────────────────────

# HTTP/HTTPS proxy for outbound requests (SSO providers, etc.)
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128

# ── medium-agent Runtime (PRIVATE — never commit real values) ───────────────
#
# Each agent has its own upstream provider block so medium and strong can
# point to completely different services, API keys, or model tiers.
#
# For Anthropic (medium):
#   MEDIUM_AGENT_API_URL            = https://api.anthropic.com
#   MEDIUM_AGENT_MESSAGES_PATH      = /v1/messages
#   MEDIUM_AGENT_API_KEY_HEADER     = x-api-key
#   MEDIUM_AGENT_API_KEY_PREFIX     = (leave empty)
#   MEDIUM_AGENT_API_VERSION_HEADER = anthropic-version
#   MEDIUM_AGENT_API_VERSION_VALUE  = 2023-06-01
#   MEDIUM_AGENT_CLIENT_TYPE        = anthropic   (LangChain adapter for mcp-host)
#
MEDIUM_AGENT_API_URL=
MEDIUM_AGENT_MESSAGES_PATH=/v1/messages
MEDIUM_AGENT_API_KEY_HEADER=x-api-key
MEDIUM_AGENT_API_KEY_PREFIX=
MEDIUM_AGENT_API_VERSION_HEADER=
MEDIUM_AGENT_API_VERSION_VALUE=
MEDIUM_AGENT_API_KEY=
MEDIUM_AGENT_MODEL_ID=
MEDIUM_AGENT_CLIENT_TYPE=anthropic

# ── strong-agent Runtime (PRIVATE — never commit real values) ───────────────
#
# For Anthropic (strong):
#   STRONG_AGENT_API_URL            = https://api.anthropic.com
#   STRONG_AGENT_MESSAGES_PATH      = /v1/messages
#   STRONG_AGENT_API_KEY_HEADER     = x-api-key
#   STRONG_AGENT_API_KEY_PREFIX     = (leave empty)
#   STRONG_AGENT_API_VERSION_HEADER = anthropic-version
#   STRONG_AGENT_API_VERSION_VALUE  = 2023-06-01
#   STRONG_AGENT_CLIENT_TYPE        = anthropic   (LangChain adapter for mcp-host)
#
STRONG_AGENT_API_URL=
STRONG_AGENT_MESSAGES_PATH=/v1/messages
STRONG_AGENT_API_KEY_HEADER=x-api-key
STRONG_AGENT_API_KEY_PREFIX=
STRONG_AGENT_API_VERSION_HEADER=
STRONG_AGENT_API_VERSION_VALUE=
STRONG_AGENT_API_KEY=
STRONG_AGENT_MODEL_ID=
STRONG_AGENT_CLIENT_TYPE=anthropic

# Internal cost accounting — per 1K raw tokens (for analytics, never shown to users)
MODEL_COST_MEDIUM_INPUT_PER_1K=0
MODEL_COST_MEDIUM_OUTPUT_PER_1K=0
MODEL_COST_STRONG_INPUT_PER_1K=0
MODEL_COST_STRONG_OUTPUT_PER_1K=0

# Product token multipliers — strong model burns Nx the user's monthly balance
MODEL_MULTIPLIER_MEDIUM=1
MODEL_MULTIPLIER_STRONG=3

# ── Monthly Gifted Quotas ─────────────────────────────────────

# Gifted product tokens per calendar month (integer)
BASE_MONTHLY_TOKENS=2000000
PRO_MONTHLY_TOKENS=5000000

# ── Pricing (override defaults set in stripe.js) ──────────────
#
# Token package prices in USD (leave empty to use code defaults)
TOKEN_PKG_STARTER_PRICE=
TOKEN_PKG_GROWTH_PRICE=
TOKEN_PKG_POWER_PRICE=

# PRO subscription price in USD
PRO_MONTHLY_PRICE=
PRO_YEARLY_PRICE=

# ── LLM Providers ────────────────────────────────────────────

# Custom LM Studio base URL (default: http://localhost:11234)
CUSTOM_LMSTUDIO_URL=

# ── Third-party Tool API Keys (Hub-side proxies) ──────────────

# Shodan (optional — used by the Shodan MCP proxy)
SHODAN_HUB_API_KEY=

# VirusTotal (optional — used by the VirusTotal MCP proxy)
VIRUSTOTAL_HUB_API_KEY=

# AbuseIPDB (optional — used by the AbuseIPDB MCP proxy)
ABUSEIPDB_HUB_API_KEY=

# ── SSO Providers ─────────────────────────────────────────────
# All SSO providers are disabled unless their *_ENABLED flag is set to "true".

# Shared callback base URL for all SSO providers
SSO_CALLBACK_BASE_URL=http://localhost:23000

# ·· Google OAuth ··
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Comma-separated scopes (default: openid,email,profile)
SSO_GOOGLE_SCOPES=

# ·· Azure AD / Entra ID (OIDC) ··
SSO_AZURE_ENABLED=false
SSO_AZURE_TENANT_ID=common
SSO_AZURE_CLIENT_ID=
SSO_AZURE_CLIENT_SECRET=
# Comma-separated scopes
SSO_AZURE_SCOPES=

# ·· AWS Cognito (OIDC) ··
SSO_AWS_ENABLED=false
SSO_AWS_CLIENT_ID=
SSO_AWS_CLIENT_SECRET=
# OIDC issuer URL, e.g. https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxx
SSO_AWS_ISSUER=
SSO_AWS_SCOPES=

# ·· WeCom / WeChat Work ··
SSO_WECHATWORK_ENABLED=false
SSO_WECHATWORK_CORP_ID=
SSO_WECHATWORK_AGENT_ID=
SSO_WECHATWORK_SECRET=
SSO_WECHATWORK_SCOPES=

# ── Audit File Writer ─────────────────────────────────────────────────────────
# Directory where daily rotating audit JSONL files are written.
# SIEM agents (Filebeat, Fluentd, Vector, etc.) should be pointed at this directory.
# Path is resolved relative to the Hub process working directory (or use an absolute path).
AUDIT_LOG_DIR=./logs/audit

# Number of days to retain daily audit log files before auto-deletion.
# Default: 90 days. Set higher for longer compliance retention.
AUDIT_LOG_RETENTION_DAYS=90
