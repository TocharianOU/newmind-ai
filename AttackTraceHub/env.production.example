# ==========================================
# NewmindHub 云环境生产配置
# ==========================================
# 使用方法:
# 1. 复制此文件: cp env.production.example .env
# 2. 修改下面标记为 [必改] 的配置
# 3. 启动服务: ./docker-deploy.sh up
# 4. 在 Stripe Dashboard 配置 webhook
# 5. 更新 STRIPE_WEBHOOK_SECRET 并重启
# ==========================================

# ==========================================
# 核心配置 [必改]
# ==========================================

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123456  # [必改] 生产环境强密码
POSTGRES_DB=newmindhub_auth

# 安全密钥 [必改]
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_OR_MORE  # [必改] 至少32字符随机字符串

# 密码加密密钥 [必改]

# Anthropic API Key [必改]
ANTHROPIC_API_KEY=sk-ant-your-api-key-here  # [必改] 你的 Anthropic API Key

# ==========================================
# Stripe 支付配置 [必改]
# ==========================================

# [必改] Stripe 生产环境密钥
# 获取地址: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_production_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_production_publishable_key

# [必改] Webhook Secret
# 步骤:
# 1. 启动服务后，访问 https://dashboard.stripe.com/webhooks
# 2. 点击 "Add endpoint"
# 3. URL 填写: https://your-domain.com/api/v1/payment/webhook
# 4. 选择事件: checkout.session.completed, invoice.payment_succeeded, 
#              customer.subscription.deleted, payment_intent.payment_failed
# 5. 保存后复制 "Signing secret" (whsec_xxx) 粘贴到下面
# 6. 重启后端: ./docker-deploy.sh restart
STRIPE_WEBHOOK_SECRET=whsec_get_this_from_stripe_dashboard

# 货币设置
STRIPE_CURRENCY=usd
STRIPE_SETTLEMENT_CURRENCY=eur

# ==========================================
# 服务端口配置
# ==========================================

BACKEND_PORT=23000
FRONTEND_PORT=23001
POSTGRES_PORT=25432

# ==========================================
# URL 配置 [必改]
# ==========================================

# [必改] 前端访问地址 (用于 Stripe 支付跳转)
# 使用域名: https://hub.yourdomain.com
# 或使用 IP: http://your-server-ip:23001
HUB_FRONTEND_URL=https://hub.yourdomain.com

# [必改] 前端构建时的 API 地址
# 使用域名: https://hub.yourdomain.com (Nginx 代理)
# 或使用 IP: http://your-server-ip:23000
VITE_API_BASE_URL=https://hub.yourdomain.com

# 文档地址 (如果没有 docs 服务可忽略)
VITE_DOCS_URL=https://hub.yourdomain.com/docs

# ==========================================
# CORS 配置 [必改]
# ==========================================

# [必改] 允许的来源
# 生产环境建议配置具体域名，包括:
# - 你的 Hub 前端域名
# - file:// (用于 Electron 应用)
# - tauri://localhost (用于 Tauri 应用)
ALLOWED_ORIGINS=https://hub.yourdomain.com,file://,tauri://localhost

# ==========================================
# 可选配置
# ==========================================

# 邀请码 (留空表示任何人都可以注册)
INVITE_CODES=

# 自定义 LM Studio URL (如果使用)
CUSTOM_LMSTUDIO_URL=

# 系统提示词覆盖 (留空使用 system-prompt.txt 文件)
DIVE_OVERRIDE_SYSTEM_PROMPT=

# 应用下载链接 (推荐配置，用于 Hub 前端显示下载按钮)
# 使用 GitHub latest 链接，自动指向 AttackTrace 最新版本
DOWNLOAD_URL_WINDOWS_X64=https://github.com/TocharianOU/attacktrace/releases/latest/download/AttackTrace-win-x64.exe
DOWNLOAD_URL_MACOS_INTEL=https://github.com/TocharianOU/attacktrace/releases/latest/download/AttackTrace-mac-x64.dmg
DOWNLOAD_URL_MACOS_APPLE_SILICON=https://github.com/TocharianOU/attacktrace/releases/latest/download/AttackTrace-mac-arm64.dmg
DOWNLOAD_URL_LINUX_X64=https://github.com/TocharianOU/attacktrace/releases/latest/download/AttackTrace-linux-x86_64.AppImage
DOWNLOAD_URL_LINUX_ARM64=

# ==========================================
# SSO 配置 (Single Sign-On) [可选]
# ==========================================

# [可选] 启用 SSO 功能
SSO_ENABLED=true

# [必改] OAuth 回调基础 URL (后端地址)
# 使用域名: https://hub.yourdomain.com
# 或使用 IP: http://your-server-ip:23000
SSO_CALLBACK_BASE_URL=https://hub.yourdomain.com

# ------------------------------------------
# Google OAuth 2.0 配置
# ------------------------------------------
# 获取步骤:
# 1. 访问 https://console.cloud.google.com/
# 2. 创建新项目或选择现有项目
# 3. 启用 "Google+ API"
# 4. 凭据 -> 创建凭据 -> OAuth 2.0 客户端 ID
# 5. 应用类型: Web 应用
# 6. 授权重定向 URI: https://hub.yourdomain.com/api/auth/sso/google/callback
# 7. 复制 Client ID 和 Client Secret

SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SSO_GOOGLE_CLIENT_SECRET=your-google-client-secret
SSO_GOOGLE_SCOPES=openid,email,profile

# ------------------------------------------
# Azure AD 配置
# ------------------------------------------
# 获取步骤:
# 1. 访问 https://portal.azure.com/
# 2. Azure Active Directory -> 应用注册 -> 新注册
# 3. 重定向 URI: https://hub.yourdomain.com/api/auth/sso/azure/callback
# 4. 证书和密码 -> 新建客户端密码
# 5. 复制应用程序(客户端) ID 和密码值

SSO_AZURE_ENABLED=false
SSO_AZURE_TENANT_ID=common
SSO_AZURE_CLIENT_ID=your-azure-client-id
SSO_AZURE_CLIENT_SECRET=your-azure-client-secret
SSO_AZURE_SCOPES=openid,email,profile

# ------------------------------------------
# AWS Cognito 配置
# ------------------------------------------
# 获取步骤:
# 1. 访问 AWS Cognito 控制台
# 2. 创建用户池
# 3. 应用程序客户端 -> 添加应用程序客户端
# 4. 启用 OAuth 2.0
# 5. 回调 URL: https://hub.yourdomain.com/api/auth/sso/aws/callback
# 6. 复制池 ID、区域和客户端 ID/密钥

SSO_AWS_ENABLED=false
SSO_AWS_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
SSO_AWS_CLIENT_ID=your-aws-cognito-client-id
SSO_AWS_CLIENT_SECRET=your-aws-cognito-client-secret
SSO_AWS_SCOPES=openid,email,profile

# ------------------------------------------
# 企业微信 (WeCom/WeChat Work) 配置
# ------------------------------------------
# 获取步骤:
# 1. 访问企业微信管理后台: https://work.weixin.qq.com/
# 2. "我的企业" -> "企业信息" -> 复制"企业ID"（CorpID）
# 3. "应用管理" -> 选择或创建应用 -> 复制"AgentId"和"Secret"
# 4. 配置"企业可信IP" -> 添加服务器公网IP
# 5. 配置"网页授权及JS-SDK" -> 添加可信域名: hub.yourdomain.com
# 6. 回调 URL: https://hub.yourdomain.com/api/auth/sso/wechatwork/callback
#
# 注意事项:
# - Secret 只能查看一次，请妥善保管
# - 可信域名不能包含端口号、协议头（http://）
# - 企业微信不提供邮箱，系统会生成虚拟邮箱: wechatwork_{userid}@sso.local

SSO_WECHATWORK_ENABLED=false
SSO_WECHATWORK_CORP_ID=ww1234567890abcdef
SSO_WECHATWORK_AGENT_ID=1000002
SSO_WECHATWORK_SECRET=your-wechatwork-application-secret
SSO_WECHATWORK_SCOPES=snsapi_base
