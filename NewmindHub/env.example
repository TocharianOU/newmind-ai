# SSO Configuration (Single Sign-On)
# Enable/disable SSO globally
SSO_ENABLED=false

# Callback base URL (backend URL for OAuth redirects)
SSO_CALLBACK_BASE_URL=http://localhost:23000

# HTTP Proxy (for accessing Google/Azure/AWS APIs in restricted networks)
# 如果在中国大陆或有网络限制的环境，需要配置代理访问 Google 等服务
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# Google OAuth 2.0 Configuration
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SSO_GOOGLE_CLIENT_SECRET=your-google-client-secret
SSO_GOOGLE_SCOPES=openid,email,profile

# Azure AD Configuration
SSO_AZURE_ENABLED=false
SSO_AZURE_TENANT_ID=common
SSO_AZURE_CLIENT_ID=your-azure-client-id
SSO_AZURE_CLIENT_SECRET=your-azure-client-secret
SSO_AZURE_SCOPES=openid,email,profile

# AWS Cognito Configuration
SSO_AWS_ENABLED=false
SSO_AWS_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
SSO_AWS_CLIENT_ID=your-aws-cognito-client-id
SSO_AWS_CLIENT_SECRET=your-aws-cognito-client-secret
SSO_AWS_SCOPES=openid,email,profile

# 企业微信 (WeCom/WeChat Work) Configuration
# 企业微信网页授权登录配置
# 获取方式：登录企业微信管理后台 (https://work.weixin.qq.com/) → 应用管理
SSO_WECHATWORK_ENABLED=false

# 企业ID（必填）- 在"我的企业" → "企业信息" 中查看
SSO_WECHATWORK_CORP_ID=ww1234567890abcdef

# 应用AgentID（必填）- 在"应用管理" → 选择应用 → "AgentId"
SSO_WECHATWORK_AGENT_ID=1000002

# 应用Secret（必填）- 在"应用管理" → 选择应用 → "Secret"
# ⚠️ 注意：Secret 只能查看一次，请妥善保管
SSO_WECHATWORK_SECRET=your-wechatwork-application-secret

# 授权范围（可选，默认为 snsapi_base）
# - snsapi_base: 静默授权，只能获取成员的基本信息（userid）
# - snsapi_privateinfo: 手动授权，可获取成员的详细信息（手机、邮箱等）
SSO_WECHATWORK_SCOPES=snsapi_base

# 重要说明：
# 1. 需要在企业微信管理后台配置"可信域名"（授权回调域）
# 2. 开发环境配置示例：localhost 或 127.0.0.1
# 3. 生产环境配置示例：yourdomain.com
# 4. 回调地址格式：{SSO_CALLBACK_BASE_URL}/api/auth/sso/wechatwork/callback

