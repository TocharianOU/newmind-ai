# ==========================================
# NewmindHub 测试环境配置
# ==========================================
# 使用方法:
# 1. 在服务器上创建: /opt/newmindhub/test/.env
# 2. 复制此文件内容并修改标记为 [必改] 的配置
# 3. GitHub Actions 会自动部署到测试环境
# ==========================================

# ==========================================
# 核心配置 [必改]
# ==========================================

# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TEST_DB_PASSWORD_CHANGE_ME  # [必改] 测试环境数据库密码
POSTGRES_DB=newmindhub_auth_test
POSTGRES_PORT=25433  # 使用不同端口避免与生产环境冲突

# 安全密钥 [必改]
JWT_SECRET=TEST_JWT_SECRET_32_CHARS_MINIMUM  # [必改] 测试环境 JWT 密钥
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Anthropic API Key [必改]
ANTHROPIC_API_KEY=sk-ant-test-api-key-here  # [必改] 可以使用测试 API Key

# ==========================================
# Stripe 支付配置 [必改 - 使用测试密钥]
# ==========================================

# [必改] Stripe 测试环境密钥
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_test_webhook_secret  # Stripe CLI 生成的测试 webhook secret
STRIPE_CURRENCY=usd
STRIPE_SETTLEMENT_CURRENCY=eur

# ==========================================
# 服务端口配置（避免与生产环境冲突）
# ==========================================

BACKEND_PORT=24000   # 不同于生产环境的 23000
FRONTEND_PORT=24001  # 不同于生产环境的 23001

# ==========================================
# URL 配置 [必改]
# ==========================================

# [必改] 前端访问地址
# 测试环境建议使用: http://test-hub.yourdomain.com 或 http://your-server-ip:24001
HUB_FRONTEND_URL=http://your-server-ip:24001

# [必改] API 地址（前端构建时使用）
# 测试环境建议使用: http://test-hub.yourdomain.com 或 http://your-server-ip:24000
VITE_API_BASE_URL=http://your-server-ip:24000

# 文档地址（可选）
VITE_DOCS_URL=http://your-server-ip:24002

# ==========================================
# CORS 配置
# ==========================================

# 测试环境可以更宽松
ALLOWED_ORIGINS=http://your-server-ip:24001,http://localhost:5174,file://,tauri://localhost

# ==========================================
# OAuth 配置（测试环境可选）
# ==========================================

OAUTH_ENABLED=false
OAUTH_CALLBACK_BASE_URL=http://your-server-ip:24000

# ==========================================
# 可选配置
# ==========================================

# 邀请码（测试环境可以留空或设置测试码）
INVITE_CODES=test2024

# 系统提示词
DIVE_OVERRIDE_SYSTEM_PROMPT=
SYSTEM_PROMPT_FILE=system-prompt.txt

# 自定义 LM Studio URL
CUSTOM_LMSTUDIO_URL=

# 应用下载链接（测试环境建议配置，用于测试下载功能）
# 使用 GitHub latest 链接，自动指向 NewChat 最新版本
DOWNLOAD_URL_WINDOWS_X64=https://github.com/TocharianOU/newmind-ai/releases/latest/download/NewChat-win-x64.exe
DOWNLOAD_URL_MACOS_INTEL=https://github.com/TocharianOU/newmind-ai/releases/latest/download/NewChat-mac-x64.dmg
DOWNLOAD_URL_MACOS_APPLE_SILICON=https://github.com/TocharianOU/newmind-ai/releases/latest/download/NewChat-mac-arm64.dmg
DOWNLOAD_URL_LINUX_X64=https://github.com/TocharianOU/newmind-ai/releases/latest/download/NewChat-linux-x86_64.AppImage
DOWNLOAD_URL_LINUX_ARM64=

# 日志级别
NODE_ENV=production
PORT=3000  # 容器内部端口，不需要改
