# NewmindHub Frontend Environment Configuration
# Copy this file to .env and update the values

# Backend API Configuration
# 注意：如果后端启用了 HTTPS，这里也要改为 https://
VITE_API_BASE_URL=http://localhost:23000

# HTTPS/SSL Configuration (Development)
# 启用 HTTPS 让前端开发服务器使用 HTTPS
# 注意：
#   1. 需要先生成 SSL 证书（参考 NewmindHub/HTTPS_QUICK_START.md）
#   2. 证书路径相对于 NewmindHub/ 目录（不是 frontend/ 目录）
#   3. 如果后端启用了 HTTPS，前端也建议启用以避免混合内容警告
VITE_ENABLE_HTTPS=false
VITE_SSL_CERT_FILE=ssl/cert.pem
VITE_SSL_KEY_FILE=ssl/key.pem

# Frontend Server Port
VITE_PORT=5174

# Docs URL
VITE_DOCS_URL=http://localhost:3002

# Stripe Publishable Key (from backend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51PJVVHId57exvnQ6hjUxD36BVyiGJSGr9SkTkxj30qyoZD5489jqqKogyqpqZ8tiJgylV9Y1QocQ7Rf1PjVBHI5h00CxJVvXHT
