# ==================== OAP Hub 部署配置模板 ====================
# 使用方式：bash deploy.sh 会自动从本文件生成 .env（已存在则不覆盖），
# 并自动为 JWT_SECRET / OAP_AUTH_TOKEN 生成随机值（下面留空即可）。
# 手动部署：cp env.copy .env 后自行填写两个密钥。

# ---------- 数据库 ----------
POSTGRES_PASSWORD=Newmind@123

# ---------- 密钥（留空则由 deploy.sh 自动生成随机值）----------
JWT_SECRET=
OAP_AUTH_TOKEN=

# ---------- 初始管理员（首次启动自动创建）----------
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=Newmind@123

# ---------- 服务 ----------
PORT=23000
DEPLOYMENT_MODE=enterprise

# ---------- 功能开关 ----------
SSO_ENABLED=false
BILLING_ENABLED=false
INVITE_CODE_ENABLED=false
LICENSE_ENABLED=false
FORCE_HTTPS=false

# ---------- 邀请码 ----------
# 注册邀请码（INVITE_CODE_ENABLED=true 时生效）+ Home 页下载包邀请码，逗号分隔多个
INVITE_CODES=hellonewmind
# 下载包专用邀请码（留空则复用 INVITE_CODES）
DOWNLOAD_INVITE_CODES=

# ---------- 跨域/前端地址（默认留空即可）----------
ALLOWED_ORIGINS=
HUB_FRONTEND_URL=
