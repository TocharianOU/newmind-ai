generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditLog {
  id           String   @id @default(cuid())
  projectId    String?
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?  @db.VarChar(50)
  userAgent    String?  @db.VarChar(500)
  createdAt    DateTime @default(now())
  Project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([projectId, createdAt])
  @@index([resourceType])
  @@index([userId, createdAt])
}

model AuthIdentity {
  id             String   @id
  userId         String
  provider       String
  providerUserId String
  email          String?
  displayName    String?
  profilePicture String?  @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([provider])
  @@index([userId])
}

model ChatSession {
  id        String    @id
  userId    String
  projectId String?
  title     String
  isStarred Boolean   @default(false)
  starredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  Message   Message[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, isStarred])
  @@index([userId, updatedAt])
}

model McpServer {
  id              String   @id
  name            String   @unique
  description     String?
  tags            Json?
  transport       String   @default("stdio")
  command         String?  @db.VarChar(200)
  args            Json?
  url             String?  @db.VarChar(500)
  env             Json?
  headers         Json?
  planRequired    String   @default("BASE")
  isActive        Boolean  @default(true)
  logo            String?  @db.VarChar(500)
  banner          String?  @db.VarChar(500)
  document        String?
  tokenCost       Float    @default(0)
  tokenRequired   Float    @default(0)
  tokenPriceUnit  String?  @default("request")
  toolTier        String?  @db.VarChar(10)
  unitPriceUsd    Float    @default(0)
  popular         Boolean  @default(false)
  new             Boolean  @default(false)
  version         String?  @db.VarChar(50)
  downloadUrl     String?  @db.VarChar(1000)
  configSchema    Json?
  descriptionI18n Json?
  documentI18n    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([planRequired])
}

model Message {
  id            String      @id
  chatSessionId String
  userId        String
  role          MessageRole
  content       String
  messageId     String?
  toolCalls     Json?
  resourceUsage Json?
  attachments   Json?
  createdAt     DateTime    @default(now())
  ChatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  User          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatSessionId, createdAt])
  @@index([userId, createdAt])
  @@unique([userId, messageId])
}

model ModelDescription {
  id          String   @id
  modelId     String   @unique
  name        String
  icon        String?  @db.VarChar(500)
  provider    String
  tokenCost   Float    @default(0)
  description String?
  extra       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([modelId])
}

model Project {
  id                     String        @id
  name                   String
  description            String?
  userId                 String
  isDefault              Boolean       @default(false)
  organizationId         String?
  inheritOrgIntegrations Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime
  AuditLog               AuditLog[]
  ChatSession            ChatSession[]
  User                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([organizationId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id
  userId    String
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
}

model Subscription {
  id                   String                @id
  userId               String                @unique
  planName             String                @default("BASE")
  isDefaultPlan        Boolean               @default(true)
  startDate            DateTime              @default(now())
  endDate              DateTime?
  nextBillingDate      DateTime?
  isActive             Boolean               @default(true)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  User                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  SubscriptionPayment  SubscriptionPayment[]

  @@index([userId])
}

model SubscriptionPayment {
  id              String        @id
  userId          String
  subscriptionId  String
  stripePaymentId String        @unique
  stripeInvoiceId String?
  amount          Float
  amountInEur     Float?
  period          String
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  paidAt          DateTime?
  Subscription    Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  User            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model TokenPurchase {
  id              String        @id
  userId          String
  stripePaymentId String        @unique
  stripeSessionId String?       @unique
  amount          Float
  amountInEur     Float?
  tokensAmount    Int
  status          PaymentStatus @default(PENDING)
  metadata        Json?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  User            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId, createdAt])
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String
  modelName    String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cost         Float    @default(0)
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, modelName])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id                         String                @id
  email                      String                @unique
  username                   String
  password                   String?
  picture                    String?               @db.VarChar(500)
  team                       String?
  role                       UserRole              @default(USER)
  tokenBalance               Int                   @default(0)
  usdBalance                 Decimal               @default(0) @db.Decimal(12, 4)
  autoTopUpEnabled           Boolean               @default(false)
  autoTopUpThreshold         Decimal               @default(5.00) @db.Decimal(12, 4)
  autoTopUpAmount            Decimal               @default(20.00) @db.Decimal(12, 4)
  stripeCustomerId           String?
  stripeDefaultPaymentMethod String?
  lastLowBalanceEmailAt      DateTime?
  monthlySpendCapUsd         Decimal?              @db.Decimal(12, 4)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime
  AuditLog            AuditLog[]
  AuthIdentity        AuthIdentity[]
  BalanceTransaction  BalanceTransaction[]
  ChatSession         ChatSession[]
  Message             Message[]
  PasswordReset       PasswordReset[]
  Project             Project[]
  RefreshToken        RefreshToken[]
  Subscription        Subscription?
  SubscriptionPayment SubscriptionPayment[]
  TokenPurchase       TokenPurchase[]
  UsageRecord         UsageRecord[]
  UserPreferences     UserPreferences?
  ToolUsageRecord     ToolUsageRecord[]
  ToolQuota           ToolQuota[]
  ToolQuotaPurchase   ToolQuotaPurchase[]

  @@index([email])
}

model UserPreferences {
  id                 String   @id @default(uuid())
  userId             String   @unique
  theme              String   @default("light")
  language           String   @default("en")
  notifications      Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Platform-wide admin-controlled settings (key-value store)
// ---------------------------------------------------------------------------

model GlobalSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum MessageRole {
  user
  assistant
  tool_call
  tool_result
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Enterprise License
// ---------------------------------------------------------------------------

model License {
  id           String    @id @default(uuid())
  customerId   String    @unique
  customerName String
  maxSeats     Int       @default(50)
  maxTokens    BigInt    @default(-1)    // -1 = unlimited
  features     String[]  @default([])   // e.g. ["sso","audit_export","advanced_mcp"]
  issuedAt     DateTime
  expiresAt    DateTime
  signature    String    @db.Text       // ed25519 base64 signature over payload
  active       Boolean   @default(true)
  activatedBy  String?                  // userId who activated this license
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
  @@index([expiresAt])
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  INVALID
  NOT_ACTIVATED
}

// ---------------------------------------------------------------------------
// Custom Model Providers (Enterprise: dynamic external model endpoints)
// ---------------------------------------------------------------------------

model CustomModel {
  id          String   @id @default(uuid())
  name        String                         // Display name shown in model list
  modelId     String   @unique               // API call identifier, e.g. "gpt-4o", "deepseek-chat"
  provider    String   @default("openai_compatible") // "openai" | "anthropic" | "openai_compatible"
  baseURL     String                         // Base URL, e.g. "https://api.openai.com/v1"
  apiKey      String   @db.Text @default("") // API key (plaintext; use env for rotation)
  active      Boolean  @default(true)
  notes       String?                        // Admin notes
  createdBy   String?                        // userId of admin who created
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

// ---------------------------------------------------------------------------
// Tool Usage & Quota (A/B/C tier system)
// ---------------------------------------------------------------------------

enum ToolTier {
  A
  B
  C
  X
}

enum KeyMode {
  hub
  byok
}

model ToolUsageRecord {
  id         String   @id @default(uuid())
  userId     String
  toolName   String
  tier       ToolTier
  keyMode    KeyMode  @default(hub)
  endpoint   String?
  chargedUsd Decimal  @default(0) @db.Decimal(12, 4)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([tier, createdAt])
}

model ToolQuota {
  id             String   @id @default(uuid())
  userId         String
  tier           ToolTier
  monthlyLimit   Int      @default(0)
  usedThisMonth  Int      @default(0)
  extraCalls     Int      @default(0)
  periodStart    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier])
  @@index([userId])
}

model ToolQuotaPurchase {
  id               String   @id @default(uuid())
  userId           String
  tier             ToolTier
  callsAmount      Int
  price            Float
  stripeSessionId  String?  @unique
  stripePaymentId  String?
  status           String   @default("PENDING")
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tier])
  @@index([stripeSessionId])
}

// ---------------------------------------------------------------------------
// USD Balance Ledger
// ---------------------------------------------------------------------------

model BalanceTransaction {
  id            String   @id @default(uuid())
  userId        String
  type          String   @db.VarChar(30)
  amountUsd     Decimal  @db.Decimal(12, 4)
  balanceBefore Decimal  @db.Decimal(12, 4)
  balanceAfter  Decimal  @db.Decimal(12, 4)
  referenceType String?  @db.VarChar(30)
  referenceId   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}
